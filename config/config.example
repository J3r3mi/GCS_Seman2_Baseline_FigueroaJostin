# ==========================================
# Configuración de ejemplo
# Sistema de Gestión de Contactos Agenda
# ==========================================

# IMPORTANTE:
# Este archivo es únicamente un ejemplo de configuración.
# No incluir contraseñas, claves privadas ni información sensible.

# ==========================================
# Configuración de la API
# ==========================================

API_URL=http://localhost:5000/api

# ==========================================
# Configuración de la base de datos
# ==========================================

DB_SERVER=localhost
DB_NAME=AgendaContactos
DB_USER=usuario_ejemplo
DB_PASSWORD=contraseña_ejemplo

# ==========================================
# Configuración del entorno
# ==========================================

ENVIRONMENT=Development

# ==========================================
# Configuración de seguridad
# ==========================================

JWT_SECRET=clave_secreta_de_ejemplo

# CR-004 - Cambio de configuración de seguridad
# Reducción del tiempo de expiración de tokens
# y habilitación de rotación de llaves.

JWT_EXPIRATION_TIME=1h
JWT_KEY_ROTATION=true

# ==========================================
# Notas
# ==========================================

# Reemplazar los valores de ejemplo por los valores
# correspondientes al entorno de ejecución.
#
# No subir archivos que contengan credenciales reales
# o información sensible al repositorio.